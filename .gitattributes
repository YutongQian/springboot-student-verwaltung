/mvnw text eol=lf
*.cmd text eol=crlf

# Sprachstatistik auf GitHub: nur Java zaehlen.
# Ohne diese Zeilen wertet GitHub den Maven-Wrapper als Shell-Skript
# und die Sprachverteilung im Repository wird verzerrt.
*.java       linguist-language=Java
*.xml        linguist-detectable=false
*.properties linguist-detectable=false
/mvnw        linguist-detectable=false
*.cmd        linguist-detectable=false
